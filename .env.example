# ─── Chatbot (Groq) ───────────────────────────────────────────
# Copia este archivo a .env.local (ignorado por git) y rellena tu clave.
# Consíguela en https://console.groq.com — nunca la subas al repositorio ni
# la expongas en código de cliente: solo se lee en el servidor (Route
# Handler src/app/api/chat/route.ts).
GROQ_API_KEY=

# Modelo a usar (ver console.groq.com/docs/models — el catálogo cambia con
# cierta frecuencia). Si se omite, se usa el valor por defecto del código
# (ver src/lib/chatbot/groqClient.ts).
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Feed de Instagram (Behold) ───────────────────────────────
# Sección de prueba con las últimas publicaciones de @calmastudio71.
# Ver src/lib/instagram.ts.

# ⭐ EDITAR: identificador del feed en https://behold.so
#   1. Crea la cuenta (plan gratuito) y conecta el Instagram profesional.
#   2. Abre el feed → botón "Embed Code" / "JSON feed".
#   3. Copia el ID final de la URL https://feeds.behold.so/XXXXXXXXXXXX
# No es un secreto (el feed es público), pero solo se lee en el servidor.
# MIENTRAS ESTÉ VACÍO se muestran fotos de ejemplo para poder ver el diseño.
BEHOLD_FEED_ID=

# Interruptor de la sección: ponlo a `false` para quitarla entera de la página
# (no deja hueco ni error). Cualquier otro valor, o sin definir, la muestra.
SHOW_INSTAGRAM_FEED=true

# Maquetación del feed: grid | carousel | moodboard. Si se omite, `grid`.
INSTAGRAM_FEED_VARIANT=grid
