# ─── Chatbot (xAI / Grok) ─────────────────────────────────────
# Copia este archivo a .env.local (ignorado por git) y rellena tu clave.
# Consíguela en https://console.x.ai — nunca la subas al repositorio ni la
# expongas en código de cliente: solo se lee en el servidor (Route Handler
# src/app/api/chat/route.ts).
XAI_API_KEY=

# Modelo a usar (ver docs.x.ai/docs/models — xAI retira/sustituye modelos
# con cierta frecuencia). Si se omite, se usa el valor por defecto del
# código (ver src/lib/chatbot/xaiClient.ts).
XAI_MODEL=grok-4.3
